#!/usr/bin/env bash
# dwm-help — keybinding cheat sheet for dwm-btw.
# Mod+Shift+h (or Mod+F1) shows it in rofi (type to filter); run `dwm-help` in a terminal to print it.
# Keep in sync with config.h when you change bindings.

KEYS='
#Apps
Mod + Return|Terminal (kitty)
Mod + d|App launcher (rofi)
Mod + n|Wi-Fi menu
Mod + v|Clipboard history
Mod + Shift + v|Clear clipboard history
Mod + a|Quick settings sidebar (notifications, Wi-Fi, Bluetooth, sound, brightness)
Mod + a → ⚙ (gear)|Settings: bar items on/off, sidebar side / overlay or push / width / margin
Sidebar avatar / name|Click: change profile picture / display name (dwm-profile)
Mod + Shift + h|This help (also Mod + Fn + F1)
#Windows
Mod + j  /  Mod + l|Focus next window
Mod + k  /  Mod + h|Focus previous window
Mod + z|Swap focused window with master
Mod + q|Close window
Mod + Shift + Space|Toggle floating
Mod + Left / Right|Shrink / grow master area
Mod + i  /  Mod + u|More / fewer windows in master
#Layouts (9, incl. suckless patches)
Mod + t|Tile  []=   master left, stack right
Mod + m  /  Mod + f|Monocle  [M]   one window full screen
Mod + g|Grid  ###   equal cells
Mod + c|Centered master  |M|
Mod + Shift + → / ←|Cycle: tile → bstack → centered → grid → deck → spiral → dwindle → monocle → float
Mod + Shift + l|Layout menu with descriptions (rofi)
Mod + Ctrl + Space|Switch to previous layout
Mod + i  /  Mod + u|More / fewer windows in master
Mod + Left / Right|Shrink / grow master area
Scroll on layout symbol|Cycle layouts (bar)
Mod + Shift + g|Gaps on / off
Mod + Shift + ↑ / ↓|Bigger / smaller gaps (inner + outer)
Mod + a → Windows|Sidebar: layouts, descriptions, master + gap controls
#Tags (workspaces)
Workspace apps|1 󰆍 kitty  2 󰖟 Brave  3 󰨞 Code  4 󰉋 Thunar  5 󰇮 Mail  6 󰇈 Obsidian  7 󰕼 VLC  10 󰑊 OBS
Rules|Mod + a → ⚙ → Workspaces (or rules.h / tags.h in the dwm source, then Rebuild)
Mod + @TAGS@|Go to tag 1 … 10
Mod + Shift + @T1@ … @T10@|Move window to tag 1 … 10
Mod + Ctrl + @T1@ … @T10@|Also show tag (toggle)
Mod + Ctrl + Shift + @T1@ … @T10@|Also put window on tag (toggle)
Mod + s|Show all tags
Mod + Ctrl + s|Put window on all tags
Mod + Tab|Previous tag
#Screenshots (saved to ~/Pictures/Screenshots + clipboard)
Mod + Shift + s|Region (drag) or window (click)
Print|Full screen
Shift + Print|Focused window
Ctrl + Print|Annotate (flameshot)
Mod + Print|Screenshot menu (delay, folder…)
#Wallpaper (~/Pictures/Wallpapers)
Mod + w|Wallpaper picker: thumbnails, random, add, fit mode, slideshow
Mod + Shift + w|Next wallpaper
Mod + a → Wallpaper|Sidebar: preview, prev / random / next, grid, fit, slideshow
#Colour picker
Mod + Shift + c|Pick a colour on screen → hex copied to clipboard
#Monitors (each screen has its own 10 workspaces)
Mod + @MN@  /  Mod + ,|Focus next / previous screen (cycles through all screens)
Mod + @T1@ … @T10@|Workspace 1–10 on the focused screen
Mod + Shift + @MN@  /  ,|Move window to next / previous screen
Example|Workspace 3 on the other screen: Mod + @MN@  then  Mod + @T3@
Plug in a screen|Applied automatically: saved layout, or extended side by side
Mod + a → ⚙ → Monitors|Map, on/off, resolution, position, primary, detect, saved layouts
#Fonts (Nerd Fonts)
Mod + a → ⚙ → Updates|Lunaris version, check now, update (also checked every Tuesday)
Mod + a → ⚙ → Workspaces|Workspace icons + which apps open where (add / edit / remove, no rebuild)
Mod + a → ⚙ → Fonts|Interface / terminal / bar font, install fonts from nerdfonts.com
dwm-font menu|Same from rofi (terminal: dwm-font set terminal "FiraCode Nerd Font")
#System
Volume keys|Volume up / down / mute
Mic-mute key|Mute microphone (noise-cancelling mic is default)
Brightness keys|Brightness up / down
Mod + Space|Switch keyboard layout (@LAYS@)
Mod + Shift + k|Reset keyboard layouts (back to @L1@)
Mod + Shift + x|Lock screen
Mod + Shift + e|Lock + suspend
Mod + Escape|Power menu (lock, suspend, log out, reboot, shut down)
Mod + Shift + d|Display menu (whole-screen scale, font size, resolution)
Mod + Shift + q|Quit dwm (logout)
Mod + Ctrl + Shift + q|Restart dwm in place (windows stay)
#Mouse
Mod + Left drag|Move window
Mod + Right drag|Resize window
Mod + Middle click|Toggle floating
Click tag|View tag  (right click: also show tag)
Mod + click tag|Move window to tag
#Status bar clicks
Keyboard  󰌌|Left: switch @LAYX@   Right: reset
Network  󰤨|Left: Wi-Fi menu   Right: nmtui
Volume  󰕾|Left: mute   Right: mixer   Scroll: volume
Microphone  󰍬|Left: mute   Right: input devices   Scroll: mic volume
Brightness  󰃟|Scroll: brightness
Battery  󰁹|Click: details
Date  󰃭|Left: calendar
Notifications  󰄛|Left: open list   Middle: clear all   Right: silent on/off
'

# keys that depend on the keyboard profile (dwm-keyboard / make KEYBOARD=...)
shopt -u patsub_replacement 2>/dev/null   # "&" in the AZERTY keys must stay literal
KBD=$(dwm-keyboard get profile 2>/dev/null || echo azerty)
LAYS=$(dwm-keyboard get layouts 2>/dev/null || echo fr,ir)
if [ "$KBD" = qwerty ]; then
	TAGS='1 2 3 4 5 6 7 8 9 0'; T1=1; T3=3; T10=0; MN=.
else
	TAGS='& é " '"'"' ( - è _ ç à'; T1='&'; T3='"'; T10='à'; MN=';'
fi
KEYS=${KEYS//@TAGS@/$TAGS}; KEYS=${KEYS//@T1@/$T1}; KEYS=${KEYS//@T3@/$T3}; KEYS=${KEYS//@T10@/$T10}
LAYN=${LAYS//,/ ⇄ }; [[ ,$LAYS, == *,ir,* ]] && LAYN+=" Persian"
KEYS=${KEYS//@LAYX@/${LAYS//,/ ⇄ }}; KEYS=${KEYS//@MN@/$MN}; KEYS=${KEYS//@LAYS@/$LAYN}; KEYS=${KEYS//@L1@/${LAYS%%,*}}

pad() { local s=$1; printf '%s%*s' "$s" $((34 - ${#s})) ''; }  # pads by characters, not bytes

# dwm passes on the startx tty, so "-t 1" alone is not enough: use rofi when dwm launched us
if [ -t 1 ] && [ "$(ps -o comm= -p "$PPID")" != dwm ]; then
	# terminal output
	while IFS='|' read -r key desc; do
		[ -z "$key" ] && continue
		if [[ $key == \#* ]]; then
			printf '\n\e[1;34m%s\e[0m\n' "${key#\#}"
		else
			printf '  \e[1m%s\e[0m %s\n' "$(pad "$key")" "$desc"
		fi
	done <<<"$KEYS"
	echo
	exit
fi

# rofi output (Pango markup)
esc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"; }
while IFS='|' read -r key desc; do
	[ -z "$key" ] && continue
	if [[ $key == \#* ]]; then
		printf '<span foreground="#7aa2f7" weight="bold">── %s ──</span>\n' "$(esc "${key#\#}")"
	else
		printf '<b>%s</b>  <span alpha="70%%">%s</span>\n' \
			"$(esc "$(pad "$key")")" "$(esc "$desc")"
	fi
done <<<"$KEYS" |
	rofi -dmenu -i -markup-rows -no-custom -p "󰌌 keys" \
		-theme-str 'window { width: 760px; } listview { lines: 18; } element-text { font: "JetBrainsMono Nerd Font Mono 11"; } element selected.normal, element selected.active { background-color: #3b4261; text-color: #c0caf5; border: 0 0 0 3px; border-color: #7aa2f7; }' \
		>/dev/null
