#!/usr/bin/env python3
"""dwm-workspaces — workspace icons and app rules (which app opens on which workspace).

  dwm-workspaces get                 JSON: {custom, supported, icons[10], rules[{class,instance,title,ws,float,follow}]}
                                     (supported: the running dwm reads the config — else rebuild once)
  dwm-workspaces save '<json>'       write the config ({icons, rules}) and restart dwm in place
  dwm-workspaces icon <1-10> <text>  set one workspace icon ("" = its number)
  dwm-workspaces add <class> <ws> [float 0/1] [follow 0/1] [title]
  dwm-workspaces rm <class> [ws]     remove the rules for an app (on one workspace)
  dwm-workspaces windows             open windows: class|instance|title (to pick an app)
  dwm-workspaces pick                click a window, prints class|instance|title
  dwm-workspaces apply               restart dwm in place (windows stay) so changes take effect
  dwm-workspaces reset               back to the built-in icons and rules (tags.h / rules.h)

Saved in ~/.config/dwm-btw/workspaces.conf (dwm reads it when it starts / restarts in place):
  icon <1-10> <text or Nerd Font glyph>
  rule <class>|<instance>|<title>|<workspace, 0 = current>|<floating 0/1>|<follow 0/1>

class / instance / title match as substrings; start with "=" for an exact match.
Icons: any text, or a Nerd Font glyph — https://www.nerdfonts.com/cheat-sheet (copy the icon, paste it).
"""
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config", "dwm-btw", "workspaces.conf")
NTAGS = 10


def dwm_dir():
    try:
        for line in open(os.path.join(HOME, ".config", "dwm-dev.conf")):
            m = re.match(r"DWM_DIR=(.*)", line.strip())
            if m:
                return os.path.expanduser(m.group(1).strip("'\""))
    except OSError:
        pass
    return os.path.join(HOME, "dwm-btw")


def c_string(s):
    return re.sub(r"\\U([0-9A-Fa-f]{8})|\\u([0-9A-Fa-f]{4})",
                  lambda m: chr(int(m.group(1) or m.group(2), 16)), s)


def defaults():
    icons = [str(i + 1) for i in range(NTAGS)]
    rules = []
    d = dwm_dir()
    try:
        src = open(os.path.join(d, "tags.h"), encoding="utf-8").read()
        body = src[src.index("tags[]"):]
        body = re.sub(r"/\*.*?\*/", "", body, flags=re.S)
        found = re.findall(r'"((?:[^"\\]|\\.)*)"', body)
        for i, t in enumerate(found[:NTAGS]):
            icons[i] = c_string(t)
    except (OSError, ValueError):
        pass
    try:
        src = open(os.path.join(d, "rules.h"), encoding="utf-8").read()
        src = src[src.index("rules[]"):]
        src = re.sub(r"/\*.*?\*/", "", src, flags=re.S)
        val = r'\s*("(?:[^"\\]|\\.)*"|NULL)\s*'
        for m in re.finditer(r"\{" + val + "," + val + "," + val + r",\s*([^,]+),\s*(\d+)\s*,\s*(-?\d+)\s*,\s*(\d+)\s*\}", src):
            cls, inst, title = (None if v == "NULL" else c_string(v[1:-1]) for v in m.group(1, 2, 3))
            t = m.group(4).strip()
            mm = re.match(r"1\s*<<\s*(\d+)", t)
            ws = int(mm.group(1)) + 1 if mm else 0
            rules.append({"class": cls or "", "instance": inst or "", "title": title or "",
                          "ws": ws, "float": int(m.group(5)), "follow": int(m.group(7))})
    except (OSError, ValueError):
        pass
    return icons, rules


def load():
    icons, rules = defaults()
    if not os.path.exists(CONF):
        return False, icons, rules
    rules = []
    for line in open(CONF, encoding="utf-8"):
        line = line.rstrip("\n")
        m = re.match(r"icon (\d+) (.*)$", line)
        if m and 1 <= int(m.group(1)) <= NTAGS:
            icons[int(m.group(1)) - 1] = m.group(2).strip() or m.group(1)
        elif line.startswith("rule "):
            f = [x.strip() for x in line[5:].split("|")] + [""] * 6
            if not (f[0] or f[1] or f[2]):
                continue
            num = lambda v, d: int(v) if re.fullmatch(r"-?\d+", v) else d
            rules.append({"class": f[0], "instance": f[1], "title": f[2],
                          "ws": num(f[3], 0), "float": num(f[4], 0), "follow": num(f[5], 1)})
    return True, icons, rules


def clean(v):
    return str(v or "").replace("|", " ").replace("\n", " ").strip()


def write(icons, rules):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    out = ["# dwm-btw workspaces — edited from the sidebar (Super+A → ⚙ → Workspaces) or by hand.",
           "# dwm reads this when it starts or restarts in place (dwm-workspaces apply).",
           "#   icon <1-10> <text or Nerd Font glyph>   (glyphs: https://www.nerdfonts.com/cheat-sheet)",
           "#   rule <class>|<instance>|<title>|<workspace 1-10, 0 = current>|<floating 0/1>|<follow 0/1>",
           "# class / instance / title: substring match, \"=name\" = exact.  Find a class: xprop WM_CLASS",
           ""]
    for i in range(NTAGS):
        ic = clean(icons[i] if i < len(icons) else "") or str(i + 1)
        out.append(f"icon {i + 1} {ic}")
    out.append("")
    for r in rules:
        c, inst, t = clean(r.get("class")), clean(r.get("instance")), clean(r.get("title"))
        if not (c or inst or t):
            continue
        ws = int(r.get("ws", 0) or 0)
        ws = ws if 0 <= ws <= NTAGS else 0
        out.append(f"rule {c}|{inst}|{t}|{ws}|{int(bool(r.get('float')))}|{int(bool(r.get('follow', 1)))}")
    tmp = CONF + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")
    os.replace(tmp, CONF)


def supported():
    """does the running dwm read workspaces.conf? (older builds only use tags.h / rules.h)"""
    try:
        pids = subprocess.run(["pgrep", "-x", "dwm"], capture_output=True, text=True).stdout.split()
        for pid in pids:
            with open(f"/proc/{pid}/exe", "rb") as f:
                if b"dwm-btw/workspaces.conf" in f.read():
                    return True
    except OSError:
        pass
    return False


def apply():
    subprocess.run(["dwm-dev", "restart"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def xprop(*args):
    try:
        return subprocess.run(["xprop", *args], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def describe(out):
    cls = re.search(r'WM_CLASS\(STRING\) = "([^"]*)", "([^"]*)"', out)
    title = re.search(r'_NET_WM_NAME\(UTF8_STRING\) = "(.*)"', out) or re.search(r'WM_NAME\(\w+\) = "(.*)"', out)
    if not cls:
        return None
    return f"{cls.group(2)}|{cls.group(1)}|{(title.group(1) if title else '').replace('|', ' ')}"


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd == "get":
        custom, icons, rules = load()
        print(json.dumps({"custom": custom, "supported": supported(), "icons": icons, "rules": rules}, ensure_ascii=False))
    elif cmd == "save" and len(a) > 2:
        d = json.loads(a[2])
        _, icons, rules = load()
        write(d.get("icons", icons), d.get("rules", rules))
        apply()
    elif cmd == "icon" and len(a) > 3 and a[2].isdigit() and 1 <= int(a[2]) <= NTAGS:
        _, icons, rules = load()
        icons[int(a[2]) - 1] = a[3] or a[2]
        write(icons, rules)
    elif cmd == "add" and len(a) > 3 and a[3].isdigit():
        _, icons, rules = load()
        rules.append({"class": a[2], "instance": "", "title": a[6] if len(a) > 6 else "",
                      "ws": int(a[3]), "float": int(a[4]) if len(a) > 4 else 0,
                      "follow": int(a[5]) if len(a) > 5 else 1})
        write(icons, rules)
    elif cmd == "rm" and len(a) > 2:
        _, icons, rules = load()
        ws = int(a[3]) if len(a) > 3 and a[3].isdigit() else None
        write(icons, [r for r in rules if not (r["class"] == a[2] and (ws is None or r["ws"] == ws))])
    elif cmd == "windows":
        root = xprop("-root", "_NET_CLIENT_LIST")
        seen = set()
        for w in re.findall(r"0x[0-9a-f]+", root):
            line = describe(xprop("-id", w, "WM_CLASS", "_NET_WM_NAME", "WM_NAME"))
            if line and line.split("|")[0] not in seen:
                seen.add(line.split("|")[0])
                print(line)
    elif cmd == "pick":
        line = describe(xprop("WM_CLASS", "_NET_WM_NAME", "WM_NAME"))
        if not line:
            return 1
        print(line)
    elif cmd == "apply":
        apply()
    elif cmd == "reset":
        if os.path.exists(CONF):
            os.remove(CONF)
        apply()
    else:
        sys.stderr.write(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv) or 0)
