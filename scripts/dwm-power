#!/usr/bin/env bash
# dwm-power — lock / suspend / logout / reboot / shutdown for dwm-btw.
#   dwm-power lock|suspend|logout|reboot|shutdown
#   dwm-power menu       rofi menu (asks before logout/reboot/shutdown)   (Mod+Escape)
#   dwm-power quit       ask, then log out (quit dwm)                      (Mod+Shift+q)

lock() {
	pgrep -x i3lock >/dev/null && return
	# dwm-lock: blurred wallpaper, profile picture, name (renders once, then cached)
	setsid -f "$HOME/.local/bin/dwm-lock" >/dev/null 2>&1 </dev/null
	# give i3lock time to grab the screen before anything else (e.g. suspend)
	for _ in $(seq 20); do pgrep -x i3lock >/dev/null && break; sleep 0.1; done
}

act() {
	case $1 in
		lock)     lock ;;
		suspend)  lock; sleep 0.3; systemctl suspend ;;
		logout)   pkill -x dwm ;;
		reboot)   systemctl reboot ;;
		shutdown) systemctl poweroff ;;
		*) echo "usage: dwm-power {lock|suspend|logout|reboot|shutdown|menu|quit}" >&2; exit 1 ;;
	esac
}

# Mod+Shift+q: quitting dwm closes every app, so ask first (Cancel is the default; Escape cancels)
if [ "$1" = quit ]; then
	n=$(xprop -root _NET_CLIENT_LIST 2>/dev/null | grep -o '0x[0-9a-f]*' | wc -l)
	ans=$(printf '%s\n' "󰜺  Cancel" "󰍃  Log out" | rofi -dmenu -i -no-custom -p "󰍃 log out" \
		-mesg "Log out of Lunaris? $( [ "${n:-0}" = 1 ] && echo "Your open window" || echo "All ${n:-} open windows" ) will be closed." \
		-theme-str 'window { width: 420px; } listview { lines: 2; }') || exit 0
	[[ $ans == *"Log out" ]] && act logout
	exit 0
fi

if [ "$1" = menu ]; then
	opts=("󰌾  Lock" "󰤄  Suspend" "󰍃  Log out" "󰜉  Reboot" "󰐥  Shut down")
	acts=(lock suspend logout reboot shutdown)
	i=$(printf '%s\n' "${opts[@]}" | rofi -dmenu -i -p "󰐥 power" -format i) || exit 0
	a=${acts[i]}
	case $a in
		logout|reboot|shutdown)
			ans=$(printf 'No\nYes, %s\n' "${opts[i]#*  }" | rofi -dmenu -i -p "Are you sure?") || exit 0
			[[ $ans == Yes* ]] || exit 0 ;;
	esac
	act "$a"
else
	act "$1"
fi
